{
  // lunotalk.com relay — deploy with:
  //   npx wrangler deploy --config deploy/lunotalk-proxy/wrangler.jsonc
  "name": "lunotalk-proxy",
  // Main account (dnjstjq0824), where lunotalk.com is registered.
  "account_id": "f5c363135efe9b22ca66eb39f2f8e1da",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  // Only the domain serves this relay; no stray workers.dev copy.
  "workers_dev": false,
  "routes": [
    { "pattern": "lunotalk.com", "custom_domain": true },
    { "pattern": "www.lunotalk.com", "custom_domain": true }
  ]
}
