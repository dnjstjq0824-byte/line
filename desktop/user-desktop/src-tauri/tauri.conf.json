{
  "productName": "Open Messenger",
  "version": "2.0.0",
  "identifier": "com.openscanner.messenger",
  "build": {
    "beforeDevCommand": "cd ../../ && npm run dev:user",
    "beforeBuildCommand": "cd ../../ && npm run build -w @messenger/user-web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../apps/user-web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open Messenger — Open Scanner Ecosystem",
        "width": 1100,
        "height": 760,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "../../../assets/brand/luno/luno-app-icon.svg"
    ]
  }
}
