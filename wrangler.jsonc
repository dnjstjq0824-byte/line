{
  "name": "line-messenger",
  "main": "scripts/cf_worker.js",
  "compatibility_date": "2026-01-01",
  "build": {
    "command": "node scripts/build_cf.js"
  },
  "assets": {
    "directory": "./dist_cf",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "line-messenger-db",
      "database_id": "ed6615d0-cc8c-40fa-96b5-82e9382d90f6"
    }
  ],
  // ---------------------------------------------------------------------------
  // Durable Objects are DELIBERATELY NOT ENABLED: they need the Workers paid plan.
  //
  // scripts/cf_worker.js exports a ready UserSocketHub class and calls into it
  // through hubFanOut(). With no USER_HUB binding every one of those calls is a
  // no-op, so the worker runs exactly as it did before: WebSocket delivery is
  // per-isolate. A recipient served by a different isolate does NOT get a live
  // push and sees the message on their next fetch instead. Messages themselves are
  // never lost -- they are committed to D1 and re-hydrated on read.
  //
  // To turn it on after upgrading the plan, restore:
  //   "durable_objects": { "bindings": [{ "name": "USER_HUB", "class_name": "UserSocketHub" }] },
  //   "migrations": [{ "tag": "v1-user-socket-hub", "new_sqlite_classes": ["UserSocketHub"] }],
  // Coverage for the enabled path is in scripts/realtime_fanout.test.mjs.
  // ---------------------------------------------------------------------------
  "vars": {
    // Preserve the existing standalone service on its one approved hostname.
    // All other public hosts still fail closed. Demo-account policy is unchanged.
    "ALLOW_LOCAL_DEMO": "true",
    "STANDALONE_HOSTS": "line-messenger.dnjstjqppk.workers.dev"
  }
}
