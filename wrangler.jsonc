{
  "name": "luno-messenger",
  // Server account (dnjstjqppk). Pinned: wrangler now sees two accounts.
  "account_id": "6d53e0a853ad74dec5fefcd4b4600e3a",
  // Stamped copy of scripts/cf_worker.js generated by the build command below.
  "main": "dist_worker/cf_worker.js",
  // Never let a routes change switch off the workers.dev host (it did once).
  "workers_dev": true,
  "compatibility_date": "2026-01-01",
  "build": {
    "command": "node scripts/build_cf.js"
  },
  "assets": {
    "directory": "./dist_cf",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /download must reach the worker (it streams the APK); the asset layer
    // would otherwise answer it with download.html, so the worker serves the
    // page itself for the download paths. Once this list exists, ONLY listed
    // paths reach the worker: every worker route has to be on it (leaving
    // out /api/* answers every API call with 405 from the asset layer).
    "run_worker_first": ["/download", "/download/", "/download.html", "/app", "/mobile", "/apk", "/api/*", "/healthz", "/readyz", "/metrics", "/.well-known/*", "/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luno-messenger-db",
      "database_id": "a07f1945-1161-48ff-90a1-888e4a86521c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "luno-media"
    }
  ],
  // ---------------------------------------------------------------------------
  // SQLite-backed Durable Objects are supported on Workers Free as well as Paid.
  // https://developers.cloudflare.com/durable-objects/platform/limits/
  // This adds a namespace; it does not migrate or delete existing D1 messages.
  // Rollback: redeploy the prior worker/bindings, retaining this namespace and
  // migration history. Do not use a deleted_classes migration as a rollback.
  // ---------------------------------------------------------------------------
  "durable_objects": { "bindings": [{ "name": "USER_HUB", "class_name": "UserSocketHub" }, { "name": "GROUP_CALLS", "class_name": "GroupCallRoom" }] },
  "migrations": [{ "tag": "v1-user-socket-hub", "new_sqlite_classes": ["UserSocketHub"] }, { "tag": "v2-group-call-room", "new_sqlite_classes": ["GroupCallRoom"] }],
  "triggers": { "crons": ["*/2 * * * *"] },
  // Local development only: `npx wrangler dev --env dev` restores the
  // localhost Vite origins for cross-origin UI work. Production
  // (top-level vars) must never list localhost (audit P1-3, 2026-11-22).
  "env": {
    "dev": {
      "vars": {
        "ALLOWED_ORIGINS": "https://luno-messenger.dnjstjqppk.workers.dev,https://lunotalk.com,https://www.lunotalk.com,http://localhost:5173,http://localhost:8080"
      }
    }
  },
  "vars": {
    // Preserve the existing standalone service on its one approved hostname.
    // All other public hosts still fail closed. Demo-account policy is unchanged.
    "STANDALONE_HOSTS": "luno-messenger.dnjstjqppk.workers.dev,lunotalk.com,www.lunotalk.com",
    "ALLOWED_ORIGINS": "https://luno-messenger.dnjstjqppk.workers.dev,https://lunotalk.com,https://www.lunotalk.com",
    // Rooms persist in D1. The two tables behind this flag are part of the
    // worker's runtime schema (ensureSchema), so no hand-applied migration
    // is needed first. Pinned by scripts/direct_chat.test.mjs.
    "DURABLE_CONVERSATIONS": "true",
    // 6-8: business consoles (partner/developer/creator/ads, rich menus, bot
    // rules) persist in D1 instead of per-isolate memory. Tables are runtime
    // schema too. Covered by scripts/f17_business.test.mjs.
    "DURABLE_BUSINESS": "true",
    // PC agent (remote work): master switch for bot routing. Only rooms and
    // users on the admin allowlist can create bot work (L-17), and the
    // killswitch (PUT admin/llm/kill) stops it at once.
    "LLM_ENABLED": "true",
    // Message translation engine (Google Cloud Translation v2). Needs the
    // GOOGLE_TRANSLATE_API_KEY secret (`wrangler secret put`), a key in GCP
    // project project-807cb089-58d7-4357-87e restricted to the Translation
    // API. Without the secret /translate fails closed (TRANSLATE_NOT_CONFIGURED).
    "TRANSLATE_PROVIDER": "google",
    // Mobile push via Firebase Cloud Messaging (same GCP project). Needs the
    // FCM_SERVICE_ACCOUNT_JSON secret (luno-fcm-sender key, FCM API Admin
    // role). Without the secret push stays off; nothing else changes.
    "PUSH_PROVIDER": "fcm",
    // Google Cloud AI engines (not LLMs) in the same GCP project: voice-note
    // transcription (Speech-to-Text v2), read-aloud (Text-to-Speech) and
    // photo screening + text-in-photo (Vision). All need the GOOGLE_AI_API_KEY
    // secret (key "luno-worker-ai", restricted to those three APIs); without
    // it they fail closed (STT/TTS/OCR_NOT_CONFIGURED) and uploads are not
    // screened.
    "GOOGLE_CLOUD_PROJECT": "project-807cb089-58d7-4357-87e",
    "STT_PROVIDER": "google",
    "TTS_PROVIDER": "google",
    "VISION_PROVIDER": "google",
    // TURN relay for calls across LTE/5G and Wi-Fi: coturn VM "luno-turn"
    // (GCP asia-northeast3-a, static IP 34.47.120.225). Credentials are minted
    // per user from the TURN_SECRET secret (coturn use-auth-secret); without
    // the secret only STUN is offered.
    "TURN_URLS": "turn:34.47.120.225:3478?transport=udp,turn:34.47.120.225:3478?transport=tcp",
    // P0-1: real mail/SMS sending. RECOVERY_MAIL_PROVIDER='resend' needs the
    // RESEND_API_KEY secret plus a verified MAIL_FROM domain (SPF/DKIM/DMARC
    // at the DNS + Resend dashboard — representative action).
    // SMS_PROVIDER='twilio' needs TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN /
    // TWILIO_FROM secrets (`wrangler secret put`). Without the keys the
    // drivers resolve to 'none' and auth routes fail closed as before.
    "MAIL_FROM": "LUNO <noreply@lunotalk.com>"
  }
}
