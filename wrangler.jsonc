{
  "name": "luno-messenger",
  // Stamped copy of scripts/cf_worker.js generated by the build command below.
  "main": "dist_worker/cf_worker.js",
  "compatibility_date": "2026-01-01",
  "build": {
    "command": "node scripts/build_cf.js"
  },
  "assets": {
    "directory": "./dist_cf",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luno-messenger-db",
      "database_id": "a07f1945-1161-48ff-90a1-888e4a86521c"
    }
  ],
  // ---------------------------------------------------------------------------
  // SQLite-backed Durable Objects are supported on Workers Free as well as Paid.
  // https://developers.cloudflare.com/durable-objects/platform/limits/
  // This adds a namespace; it does not migrate or delete existing D1 messages.
  // Rollback: redeploy the prior worker/bindings, retaining this namespace and
  // migration history. Do not use a deleted_classes migration as a rollback.
  // ---------------------------------------------------------------------------
  "durable_objects": { "bindings": [{ "name": "USER_HUB", "class_name": "UserSocketHub" }] },
  "migrations": [{ "tag": "v1-user-socket-hub", "new_sqlite_classes": ["UserSocketHub"] }],
  "vars": {
    // Preserve the existing standalone service on its one approved hostname.
    // All other public hosts still fail closed. Demo-account policy is unchanged.
    "STANDALONE_HOSTS": "luno-messenger.dnjstjqppk.workers.dev",
    "ALLOWED_ORIGINS": "https://luno-messenger.dnjstjqppk.workers.dev,http://localhost:5173,http://localhost:8080"
  }
}
